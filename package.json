{
  "name": "mcp-streamable-guard",
  "version": "0.1.0",
  "description": "A deterministic guard for physical MCP tools: source tagging, signed one-time passes, approvals by elicitation, a pure allow/block policy tested on every input combination, and a proxy that puts it in front of any MCP server.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "alexa",
    "guard",
    "mcp",
    "model-context-protocol",
    "prompt-injection",
    "proxy",
    "smart-home"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "homepulse-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./policy": {
      "homepulse-source": "./src/policy.ts",
      "types": "./dist/policy.d.ts",
      "default": "./dist/policy.js"
    },
    "./spec": {
      "homepulse-source": "./src/spec.ts",
      "types": "./dist/spec.d.ts",
      "default": "./dist/spec.js"
    },
    "./inputs": {
      "homepulse-source": "./src/inputs.ts",
      "types": "./dist/inputs.d.ts",
      "default": "./dist/inputs.js"
    },
    "./approvals": {
      "homepulse-source": "./src/approvals.ts",
      "types": "./dist/approvals.d.ts",
      "default": "./dist/approvals.js"
    },
    "./proxy": {
      "homepulse-source": "./src/proxy/index.ts",
      "types": "./dist/proxy/index.d.ts",
      "default": "./dist/proxy/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/guard"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcp-streamable-guard": "./dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "^5.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}
