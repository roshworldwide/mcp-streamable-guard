{
  "name": "mcp-streamable-guard",
  "version": "0.1.0",
  "description": "A deterministic guard for physical MCP tools: source tagging, signed one-time passes, approvals by elicitation, a pure allow/block policy tested on every input combination, and a proxy that puts it in front of any MCP server.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "alexa",
    "guard",
    "mcp",
    "model-context-protocol",
    "prompt-injection",
    "proxy",
    "smart-home"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roshworldwide/mcp-streamable-guard.git"
  },
  "homepage": "https://github.com/roshworldwide/mcp-streamable-guard#readme",
  "bugs": "https://github.com/roshworldwide/mcp-streamable-guard/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "default": "./dist/policy.js"
    },
    "./spec": {
      "types": "./dist/spec.d.ts",
      "default": "./dist/spec.js"
    },
    "./inputs": {
      "types": "./dist/inputs.d.ts",
      "default": "./dist/inputs.js"
    },
    "./approvals": {
      "types": "./dist/approvals.d.ts",
      "default": "./dist/approvals.js"
    },
    "./proxy": {
      "types": "./dist/proxy/index.d.ts",
      "default": "./dist/proxy/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "mcp-streamable-guard": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json",
    "test": "vitest run",
    "test:exhaustive": "vitest run test/exhaustive.test.ts",
    "demo": "tsx examples/smartlock-co/demo.ts",
    "smartlock": "tsx examples/smartlock-co/server.ts",
    "proxy": "tsx src/cli.ts proxy"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "^5.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
