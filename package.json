{
  "name": "mcp-streamable-guard",
  "version": "0.1.0",
  "description": "A deterministic guard for physical MCP tools: source tagging, signed one-time passes, and a pure allow/block policy tested on every input combination.",
  "license": "MIT",
  "type": "module",
  "keywords": ["mcp", "model-context-protocol", "prompt-injection", "guard", "smart-home", "alexa"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./policy": {
      "source": "./src/policy.ts",
      "types": "./dist/policy.d.ts",
      "default": "./dist/policy.js"
    },
    "./spec": {
      "source": "./src/spec.ts",
      "types": "./dist/spec.d.ts",
      "default": "./dist/spec.js"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/guard"
  },
  "engines": {
    "node": ">=20"
  }
}
